## =========================================================
## Anambra State Ministry of Commerce — Environment Vars
## TEMPLATE with placeholders. COPY this file to `.env.local`
## (which is already .gitignored) and fill in the secrets.
## =========================================================

## ----------------------------------------------------------------
## Next.js Runtime
## ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-production-domain.example.com
NODE_ENV=production

## ----------------------------------------------------------------
## Firebase Client (Web SDK — exposed to browser, prefix NEXT_PUBLIC_)
## Copy values from: Firebase Console →
##   Project settings → "Your apps" → Web App → "Config" snippet
##
## NOTE: NEXT_PUBLIC_* values are intentionally delivered to the
## browser. NEVER put server-only secrets (Admin keys, API secrets)
## in variables with the NEXT_PUBLIC_ prefix.
## ----------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaREPLACE_ME__YOUR_CLIENT_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_ME.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_ME.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME_NUMERIC_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=1:REPLACE_ME_NUMERIC:web:REPLACE_ME_APP_ID_SUFFIX
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-REPLACE_ME_MEASUREMENT_ID

## ----------------------------------------------------------------
## Firebase Admin (Server-Only — NEVER expose these to the browser)
## Copy values from your service-account JSON file exactly:
##   Firebase Console → Settings → Service Accounts →
##   "Generate new private key" → open the .json file it downloads
##
## For FIREBASE_ADMIN_PRIVATE_KEY, paste the entire multi-line
## key with literal \n sequences (not actual newlines) wrapped in
## double quotes, exactly as it appears in the service-account JSON.
## ----------------------------------------------------------------
FIREBASE_PROJECT_ID=REPLACE_ME
FIREBASE_ADMIN_PRIVATE_KEY_ID=REPLACE_ME_PRIVATE_KEY_ID
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME_WITH_LITERAL_BACKSLASH_N_NEWLINES\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-REPLACE_ME@REPLACE_ME.iam.gserviceaccount.com
FIREBASE_ADMIN_CLIENT_ID=REPLACE_ME_NUMERIC_CLIENT_ID
FIREBASE_STORAGE_BUCKET=REPLACE_ME.appspot.com

## ----------------------------------------------------------------
## Cloudinary — Media & Image Uploads
## Dashboard: https://console.cloudinary.com/
##
## CLOUDINARY_API_SECRET must NOT have the NEXT_PUBLIC_ prefix.
## Upload Preset: Cloudinary → Settings → Upload → Upload Presets
##   → Add Upload Preset (unsigned public uploads are disabled;
##   use signed uploads via /api/cloudinary/sign or the
##   server proxy /api/cloudinary/upload.)
## ----------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=REPLACE_ME_CLOUD_NAME
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=REPLACE_ME_UPLOAD_PRESET_NAME
CLOUDINARY_API_KEY=REPLACE_ME_NUMERIC_API_KEY
CLOUDINARY_API_SECRET=REPLACE_ME_API_SECRET
